# Base URL of the Render API.
# For CI, set this as a repo Variable (not secret):
#   Settings -> Secrets and variables -> Actions -> Variables -> New variable
#   Name: VITE_API_URL
# For local dev, copy this file to `.env.local` and adjust.
VITE_API_URL=https://elemental-monster-duel-api.onrender.com

# Supabase project — read directly from the UI (bypassing the api) for data
# that must stay available even if the api itself is down/being deployed
# (see maintenance_window). The anon key is meant to be public — it's only
# as safe as the RLS policies behind it, not a secret to hide. Still a repo
# Variable, not a secret, same as VITE_API_URL above.
#   URL: Supabase dashboard -> Settings -> Data API -> Project URL
#   Anon key: Supabase dashboard -> Settings -> API Keys -> anon / public
VITE_SUPABASE_URL=https://kjbfrarpdraxskfrqpyg.supabase.co
VITE_SUPABASE_ANON_KEY=
